{
  "uid": "errors-and-latency",
  "title": "Errors and latency",
  "description": "4xx and 5xx ratios and latency for WordPress routers and the http and https entrypoints.",
  "tags": [
    "rhdwp",
    "traefik"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "links": [
    {
      "title": "Mission control",
      "type": "link",
      "url": "/d/mission-control",
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Traffic by site",
      "type": "link",
      "url": "/d/traffic-by-site",
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Containers",
      "type": "link",
      "url": "/d/containers",
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "RHDWP Traefik",
      "type": "link",
      "url": "/d/rhdwp-traefik",
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Routers",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "4xx ratio by router",
      "description": "4xx responses divided by all responses for each *_apache-secure router.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(\n  sum by (router) (rate(traefik_router_requests_total{router=~\".*_apache-secure.*\",code=~\"4..\"}[5m]))\n  or\n  sum by (router) (rate(traefik_router_requests_total{router=~\".*_apache-secure.*\"}[5m])) * 0\n)\n/\nclamp_min(sum by (router) (rate(traefik_router_requests_total{router=~\".*_apache-secure.*\"}[5m])), 0.001)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{router}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
